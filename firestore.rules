rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Pengaturan Pemilihan (Buka/Tutup voting, background, data paslon)
    // Diizinkan baca & tulis agar tombol Buka/Tutup Suara di Panel Admin berfungsi
    match /settings/{document=**} {
      allow read, write: if true;
    }

    // 2. Riwayat Pemilih (Mencegah Double Voting)
    match /voters/{voterId} {
      // Izinkan baca status pemilih & getDocs saat reset pemilihan
      allow read: if true;
      
      // HANYA boleh dibuat jika dokumen belum ada sebelumnya (Anti-Double Voting)
      allow create: if !exists(/databases/$(database)/documents/voters/$(voterId));
      
      // Status hak suara yang sudah masuk TIDAK BOLEH diubah/dimanipulasi
      allow update: if false; 
      
      // Diizinkan hapus saat panitia melakukan reset suara
      allow delete: if true; 
    }

    // 3. Kotak Surat Suara (Asas LUBER: Rahasia & Anti-Tamper)
    match /votes/{voteId} {
      // Hasil perolehan suara dapat dibaca untuk Quick Count real-time
      allow read: if true;
      
      // Surat suara hanya boleh ditambahkan bernilai 1 suara per submit
      allow create: if request.resource.data.votes == 1;
      
      // Surat suara yang sudah masuk TIDAK BOLEH diubah/diedit oleh siapa pun!
      allow update: if false; 
      
      // Diizinkan hapus saat panitia melakukan reset suara
      allow delete: if true; 
    }
  }
}
