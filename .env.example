# Salin file ini menjadi .env lalu isi nilainya dari Firebase Console
# Project settings -> General -> Your apps -> Web app (</>)

VITE_FIREBASE_API_KEY=AIzaSyExampleKey123456789
VITE_FIREBASE_AUTH_DOMAIN=nama-project-kamu.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nama-project-kamu
VITE_FIREBASE_STORAGE_BUCKET=nama-project-kamu.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
